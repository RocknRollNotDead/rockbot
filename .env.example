# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env НИКОГДА не коммитится в git — добавьте его в .gitignore.

BOT_TOKEN=123456789:ABCDefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=MyRockBandBot

# Название группы — отображается в боте
BAND_NAME=Название Группы

# Telegram ID администраторов через запятую
# Узнать свой ID можно у бота @userinfobot
ADMIN_IDS=111111111,222222222

# Кому приходят уведомления о запросах на вступление в группу.
# По умолчанию (если не указан) — первый администратор из ADMIN_IDS.
# Можно сменить командой /setrecipient <userId> прямо в боте.
REQUEST_RECIPIENT_ID=

# Директория для автоматического импорта песен.
# Бот найдёт .mp3/.ogg/.flac файлы и добавит их как песни.
# Формат имён: "Название.mp3" или "Название - Альбом.mp3"
# Обновить список: команда /updateimport (только для администраторов)
IMPORT_DIR=
